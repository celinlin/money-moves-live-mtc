# Supabase project (Dashboard → Project Settings → API). The anon/publishable key
# is safe to expose in the browser: all access is enforced by RLS + RPC checks.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: public URL participants use to join (used for the QR code and join link).
# Defaults to the current origin. Set it when presenting from localhost so phones get a reachable address.
VITE_PUBLIC_APP_URL=

# Optional: set to "false" to hide the sign-up tab on /host once your presenter account exists.
VITE_ALLOW_HOST_SIGNUP=true
